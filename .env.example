# =============================================================================
# MyCash — variaveis de ambiente
#
#   cp .env.example .env    e preencha
#
# Este arquivo e versionado; `.env` e `.env.local` NAO (ver .gitignore e
# .dockerignore). O Twelve-Factor App trata configuracao como algo que vive no
# ambiente, nao no codigo: a mesma imagem Docker roda em local, homologacao e
# producao, e o que muda e so o que esta aqui.
#
# =============================================================================
# A distincao que mais importa neste projeto
# =============================================================================
#
# NEXT_PUBLIC_*  ->  variavel de BUILD. O compilador do Next troca cada
#                    `process.env.NEXT_PUBLIC_X` pelo valor literal dentro do
#                    bundle JavaScript. Depois do `npm run build` o valor esta
#                    no arquivo que o navegador baixa. Qualquer pessoa le com
#                    Ctrl+U. Mudar depois do build nao tem efeito no cliente —
#                    e preciso recompilar.
#
# sem prefixo    ->  variavel de RUNTIME. Fica so no processo Node do
#                    servidor, nunca e enviada ao navegador. E aqui que
#                    credencial mora.
#
# A regra que decorre disso: NUNCA prefixe um segredo com NEXT_PUBLIC_.
# `NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY` publicaria na internet uma chave que
# ignora RLS — acesso total ao banco de todos os usuarios. Em producao de
# verdade a injecao viria de um cofre (Vault, AWS Secrets Manager), nao de
# arquivo em disco.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — publicas (vao para o bundle do cliente)
# -----------------------------------------------------------------------------

# URL do projeto. Publica: aparece em toda requisicao que o navegador faz.
# Painel -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Anon key. Publica POR DESIGN — e desenhada para ir ao cliente, e quem
# protege os dados e a Row Level Security, nao o sigilo desta chave. Sem RLS
# ativa, porem, ela da leitura de tudo: a protecao esta nas policies, nao
# aqui.
# Painel -> Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL publica da aplicacao. Usada em redirect de OAuth e em link de e-mail.
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Supabase — privada (NUNCA chega ao navegador)
# -----------------------------------------------------------------------------

# Service role key. IGNORA RLS: quem tem esta chave le e escreve a tabela de
# qualquer usuario. Usada apenas no servidor, e so onde e inevitavel — o
# ingest do Pluggy escreve em nome do usuario antes de existir uma sessao.
# Nao tem, e nao pode ganhar, prefixo NEXT_PUBLIC_.
# Painel -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Pluggy (Open Finance) — privadas
#
# Opcionais: sem elas o app sobe normalmente e so a conexao com banco via
# Open Finance fica indisponivel (getPluggyClient lanca erro explicito).
# -----------------------------------------------------------------------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# PostgreSQL local (servico `db` do compose)
#
# Credencial de banco efemero na maquina de quem desenvolve. Nao e producao:
# producao e Supabase gerenciado. Mesmo assim fica aqui e nao fixa no
# compose.yaml — senao viraria segredo versionado, que e o habito que vaza
# quando alguem copia o arquivo para um projeto de verdade.
# -----------------------------------------------------------------------------
POSTGRES_USER=mycash
POSTGRES_PASSWORD=mycash_local
POSTGRES_DB=mycash


# -----------------------------------------------------------------------------
# Mobile (Expo) — ver mobile/.env
#
# O Expo usa o prefixo EXPO_PUBLIC_, com a mesma semantica do NEXT_PUBLIC_:
# valor embutido no bundle em tempo de build. Vale a mesma regra — nada de
# segredo ali.
#
#   EXPO_PUBLIC_SUPABASE_URL=
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=
#   EXPO_PUBLIC_API_URL=        # default: https://mycash-nu.vercel.app
# -----------------------------------------------------------------------------
