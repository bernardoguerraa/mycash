# Copie para .env (que e ignorado pelo git) e preencha.
# Sao os mesmos valores de NEXT_PUBLIC_SUPABASE_* do .env.local da raiz.
#
# O prefixo EXPO_PUBLIC_ e obrigatorio: so variaveis com ele chegam ao
# codigo do app. Elas ficam embutidas no bundle, entao aqui vai APENAS a
# chave anon (protegida por RLS) — nunca a service role.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
